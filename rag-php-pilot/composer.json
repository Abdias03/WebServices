{
    "name": "abdias03/rag-php-pilot",
    "description": "Isolated PHP unit-test pilot for RAG Test Studio; preserves the Java application.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "RagPilot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RagPilot\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
